# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/tg            # -> data/tg.session (chmod 600, не комітити!)

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

TG_DB_PATH=data/brain.db
TG_VAULT_DIR=data/vault            # markdown-сховище самарі
TG_TIMEZONE=Europe/Kyiv
SYNC_INTERVAL_MIN=30               # 0 = вимкнути періодичну синхронізацію
BACKFILL_DAYS=7                    # скільки історії тягнути при першому підключенні чату
TG_ALLOW_SEND=0                    # 1 = дозволити tool send_message

# Безпека: send_message вимкнено, доки явно не ввімкнеш (TG_ALLOW_SEND=1 вище).
# Ніколи не комітити .env, data/ та *.session — вони вже в .gitignore.
